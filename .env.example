# Copy to .env and edit. Every value has a working default except the password.
# The server reads plain environment variables — `.env` is loaded by
# docker-compose, or source it yourself before `npm start`.

# ---- HTTP -------------------------------------------------------------------
PC_HOST=0.0.0.0
PC_PORT=8080

# ---- MQTT broker ------------------------------------------------------------
# On the same host as the server, this stays 127.0.0.1. Use mqtts:// on 8883
# once TLS is configured — required if the broker is reachable from the internet.
PC_MQTT_URL=mqtt://127.0.0.1:1883
PC_MQTT_USERNAME=powercord-server
PC_MQTT_PASSWORD=change-me

# Register a strip automatically the first time it publishes. Convenient at
# home; turn it off on a shared broker so a stranger's device cannot appear in
# your account.
PC_AUTO_DISCOVER=true

# ---- Storage ----------------------------------------------------------------
PC_DB=./data/powercord.db

# ---- Auth -------------------------------------------------------------------
# Seeds the first user on an empty database. If left blank the server generates
# a password and prints it once at startup — read the log.
PC_ADMIN_USER=admin
PC_ADMIN_PASSWORD=
PC_TOKEN_TTL_DAYS=30

# ---- Behaviour --------------------------------------------------------------
# A command with no confirming state message inside this window is reverted in
# the UI. Raise it only if your network is genuinely slow; the point of it is
# that a user never believes a heater is off when it is on.
PC_COMMAND_TIMEOUT_MS=3000
PC_OFFLINE_AFTER_MS=150000
PC_SAMPLE_INTERVAL_MS=60000
PC_TICK_INTERVAL_MS=15000
PC_RAW_RETENTION_HOURS=48
